---
// Det som sidorna under /uppdrag delar: namnen på kommuner och områden, som korten slår upp,
// och stilen för korten och formuläret. Korten ritas i webbläsaren, så stilen är global.
import { hamtaData } from '../lib/data';
import type { Etiketter } from '../lib/uppdragkort';

const d = hamtaData();
const etiketter: Etiketter = {
  kommuner: Object.fromEntries(d.kommuner.map((k) => [k.kod, k.namn])),
  omraden: Object.fromEntries(d.taxonomi.omraden.map((o) => [o.id, o.label])),
};
---

<script type="application/json" id="uppdrag-etiketter" set:html={JSON.stringify(etiketter)} />

<style is:global>
  /* En regel med display får inte vinna över hidden, som sidornas skript sätter. */
  :is(.uppdrag__filter, .redigera, .uppdragsform, .besked)[hidden] {
    display: none !important;
  }
  .profiler {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .profil {
    display: grid;
    gap: 12px;
    align-content: start;
    padding: 18px;
    border: 1px solid hsl(var(--kant));
    border-radius: var(--r-ruta);
    background: hsl(var(--yta-kort));
    min-width: 0;
  }
  .profil__topp {
    display: flex;
    gap: 12px;
    align-items: center;
    min-width: 0;
  }
  .profil__glyf {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: hsl(var(--moss));
    color: hsl(var(--bg));
    font: 600 19px/1 var(--font-sans);
  }
  .profil__namnblock {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .profil__namn {
    margin: 0;
    color: hsl(var(--ink));
    font: 600 18px/1.25 var(--font-sans);
    overflow-wrap: anywhere;
  }
  .profil__medlem {
    margin: 0;
    font: 400 11.5px/1.3 var(--font-mono);
    letter-spacing: 0.03em;
    color: hsl(var(--ink-mute));
  }
  .profil__rubrik {
    margin: 0;
    color: hsl(var(--ink));
    font-size: 15.5px;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }
  .profil__taggar {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .profil__erbjuder {
    border-color: hsl(var(--moss) / 0.35);
    background: hsl(var(--moss) / 0.08);
    color: hsl(var(--moss));
  }
  .profil__bolag {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .profil__fot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 12px;
  }
  .profil__knapp[aria-disabled='true'] {
    cursor: default;
  }

  /* Formulären */
  .uppdragsform {
    display: grid;
    gap: 18px;
    max-width: 560px;
  }
  .uppdragsform fieldset {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .uppdragsform legend,
  .falt__etikett {
    padding: 0;
    color: hsl(var(--ink));
    font-weight: 600;
    font-size: 15px;
  }
  .falt {
    display: grid;
    gap: 6px;
  }
  .falt__hjalp {
    margin: 0;
    font-size: 13.5px;
    color: hsl(var(--ink-mute));
  }
  .falt__fel {
    margin: 0;
    font-size: 13.5px;
    font-weight: 600;
    color: hsl(var(--rust));
  }
  .uppdragsform input[type='text'],
  .uppdragsform input[type='email'],
  .uppdragsform input[type='url'],
  .uppdragsform select {
    width: 100%;
    min-height: 46px;
    padding: 10px 12px;
    border: 1.5px solid hsl(var(--rule));
    border-radius: var(--r-btn);
    background: hsl(var(--bg));
    color: hsl(var(--ink));
    font: 400 16px/1.3 var(--font-sans);
  }
  .uppdragsform input:focus-visible,
  .uppdragsform select:focus-visible {
    outline: 0;
    border-color: hsl(var(--moss));
    box-shadow: 0 0 0 3px hsl(var(--moss) / 0.15);
  }
  .uppdragsform [aria-invalid='true'] {
    border-color: hsl(var(--rust));
  }
  .val {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 15px;
    line-height: 1.4;
    cursor: pointer;
  }
  .val input {
    flex: none;
    width: 18px;
    height: 18px;
    margin: 1px 0 0;
    accent-color: hsl(var(--moss));
  }
  .valrutnat {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    gap: 8px 16px;
  }
  .val:has(input:disabled) {
    color: hsl(var(--ink-mute));
    cursor: default;
  }
  .honung {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .besked {
    padding: 16px 18px;
    border-radius: var(--r-card);
    background: hsl(var(--bg-soft));
    border-left: 3px solid hsl(var(--moss));
  }
  .besked--fel {
    border-left-color: hsl(var(--rust));
  }
  .besked p {
    margin: 0;
  }
  .besked p + p {
    margin-top: 8px;
  }
  .knapp:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .knapp--fara {
    background: transparent;
    border-color: hsl(var(--rust) / 0.5);
    color: hsl(var(--rust));
  }
  .knapp--fara:hover {
    background: hsl(var(--rust) / 0.08);
    border-color: hsl(var(--rust));
    color: hsl(var(--rust));
  }
</style>
